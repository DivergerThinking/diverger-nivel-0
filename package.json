{
  "name": "diverger-golden-path",
  "version": "0.1.0",
  "private": true,
  "description": "Plantilla de repo del golden path de Diverger: Node.js con TypeScript, React, inicio de sesión con Google y un módulo por bounded context.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "gen": "node scripts/generar-tipos.mjs",
    "lint": "eslint .",
    "lint:openapi": "node scripts/lint-openapi.mjs",
    "lint:deps": "depcruise app lib src web --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "npm run gen && vite build && tsc -p tsconfig.server.json",
    "dev": "vite",
    "start": "node dist/server/app/main.js",
    "check": "npm run gen && npm run lint && npm run lint:openapi && npm run lint:deps && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@google-cloud/firestore": "9.4.0",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.71.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
