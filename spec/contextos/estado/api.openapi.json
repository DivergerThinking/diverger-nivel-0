{
  "openapi": "3.1.0",
  "info": {
    "title": "Estado",
    "version": "1.0.0",
    "description": "Contexto estado de la iniciativa de prueba de la escalera de reintentos."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "google": []
    }
  ],
  "paths": {
    "/api/estado": {
      "get": {
        "operationId": "estado.consultarEstado",
        "summary": "Estado del servicio",
        "parameters": [
          {
            "name": "formato",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "En marcha",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "estado": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "estado"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Formato no admitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Falta el inicio de sesión o el token no es válido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "google": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token de identidad de Google (Google Identity Services)"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
