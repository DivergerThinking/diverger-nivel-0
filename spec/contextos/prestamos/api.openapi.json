{
  "openapi": "3.1.0",
  "info": {
    "title": "Préstamos",
    "version": "1.0.0",
    "description": "Lista de equipos con su préstamo, préstamos y devoluciones. Sigue la API fijada por el cliente para el inventario de IT."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "google": [] }],
  "paths": {
    "/api/equipos": {
      "get": {
        "operationId": "prestamos.listarEquipos",
        "summary": "Ver los equipos",
        "responses": {
          "200": {
            "description": "La lista de equipos, cada uno con `id`, `nombre` y `prestado`; si está prestado, también `persona` y `devolucion`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/EquipoConPrestamo" }
                }
              }
            }
          },
          "401": {
            "description": "«Inicia sesión con Google.», sin un token válido",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/api/equipos/{id}/prestamo": {
      "post": {
        "operationId": "prestamos.prestarEquipo",
        "summary": "Prestar un equipo",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Prestamo" } }
          }
        },
        "responses": {
          "201": {
            "description": "El equipo, prestado: `id`, `nombre`, `prestado: true`, `persona` y `devolucion`",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/EquipoPrestado" } }
            }
          },
          "400": {
            "description": "«Faltan la persona o la fecha de devolución», o «La fecha de devolución no es válida» si no es una fecha real",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "«Inicia sesión con Google.», sin un token válido",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "«No existe el equipo»",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "409": {
            "description": "«El equipo ya está prestado»",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/api/equipos/{id}/devolucion": {
      "post": {
        "operationId": "prestamos.devolverEquipo",
        "summary": "Apuntar la devolución",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "El equipo, con `prestado: false`",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/EquipoDevuelto" } }
            }
          },
          "401": {
            "description": "«Inicia sesión con Google.», sin un token válido",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "«No existe el equipo»",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "409": {
            "description": "«El equipo no está prestado»",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "google": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token de identidad de Google, con el correo verificado, emitido para el cliente OAuth de la aplicación; de una persona o de una cuenta de servicio"
      }
    },
    "schemas": {
      "Prestamo": {
        "type": "object",
        "required": ["persona", "devolucion"],
        "properties": {
          "persona": { "type": "string", "examples": ["Ana Pérez"] },
          "devolucion": {
            "type": "string",
            "description": "Fecha de devolución como texto AAAA-MM-DD; tiene que ser una fecha que exista y puede ser pasada",
            "examples": ["2026-11-20"]
          }
        }
      },
      "EquipoConPrestamo": {
        "type": "object",
        "required": ["id", "nombre", "prestado"],
        "properties": {
          "id": { "type": "string" },
          "nombre": { "type": "string", "examples": ["Portátil 07"] },
          "prestado": { "type": "boolean" },
          "persona": { "type": "string", "description": "Solo si está prestado", "examples": ["Ana Pérez"] },
          "devolucion": { "type": "string", "description": "Solo si está prestado; texto AAAA-MM-DD", "examples": ["2026-11-20"] }
        }
      },
      "EquipoPrestado": {
        "type": "object",
        "required": ["id", "nombre", "prestado", "persona", "devolucion"],
        "properties": {
          "id": { "type": "string" },
          "nombre": { "type": "string" },
          "prestado": { "type": "boolean", "const": true },
          "persona": { "type": "string" },
          "devolucion": { "type": "string", "description": "Texto AAAA-MM-DD, igual que se recibió" }
        }
      },
      "EquipoDevuelto": {
        "type": "object",
        "required": ["id", "nombre", "prestado"],
        "properties": {
          "id": { "type": "string" },
          "nombre": { "type": "string" },
          "prestado": { "type": "boolean", "const": false }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string", "description": "El mensaje exacto de la API fijada por el cliente" }
        }
      }
    }
  }
}
