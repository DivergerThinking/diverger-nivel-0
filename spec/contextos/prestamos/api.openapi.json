{
  "openapi": "3.1.0",
  "info": {
    "title": "Préstamos",
    "version": "1.0.0",
    "description": "Lista de equipos con su préstamo, préstamos y devoluciones. Sigue la API fijada por el cliente (ADR 0001)."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "google": [] }],
  "paths": {
    "/api/equipos": {
      "get": {
        "operationId": "prestamos.listarEquipos",
        "summary": "Ver los equipos",
        "responses": {
          "200": {
            "description": "La lista de equipos, cada uno con su préstamo si está prestado",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Equipo" } }
              }
            }
          },
          "401": {
            "description": "Inicia sesión con Google.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/api/equipos/{id}/prestamo": {
      "post": {
        "operationId": "prestamos.prestarEquipo",
        "summary": "Prestar un equipo",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/PrestamoNuevo" } }
          }
        },
        "responses": {
          "201": {
            "description": "El equipo, prestado, con la persona y la fecha de devolución",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Equipo" } }
            }
          },
          "400": {
            "description": "Faltan la persona o la fecha de devolución, o bien: La fecha de devolución no es válida",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "Inicia sesión con Google.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "No existe el equipo",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "409": {
            "description": "El equipo ya está prestado",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/api/equipos/{id}/devolucion": {
      "post": {
        "operationId": "prestamos.devolverEquipo",
        "summary": "Apuntar la devolución",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "El equipo, sin prestar",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Equipo" } }
            }
          },
          "401": {
            "description": "Inicia sesión con Google.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "No existe el equipo",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "409": {
            "description": "El equipo no está prestado",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "google": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token de identidad de Google, con el correo verificado, emitido para el cliente OAuth de la aplicación; de una persona o de una cuenta de servicio"
      }
    },
    "schemas": {
      "Equipo": {
        "type": "object",
        "required": ["id", "nombre", "prestado"],
        "properties": {
          "id": { "type": "string" },
          "nombre": { "type": "string" },
          "prestado": { "type": "boolean" },
          "persona": { "type": "string", "description": "Solo si el equipo está prestado" },
          "devolucion": { "type": "string", "description": "Fecha de devolución como texto AAAA-MM-DD; solo si el equipo está prestado" }
        }
      },
      "PrestamoNuevo": {
        "type": "object",
        "properties": {
          "persona": { "type": "string" },
          "devolucion": { "type": "string", "description": "Fecha de devolución como texto AAAA-MM-DD" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      }
    }
  }
}
