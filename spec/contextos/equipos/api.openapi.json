{
  "openapi": "3.1.0",
  "info": {
    "title": "Equipos",
    "version": "1.0.0",
    "description": "Alta de los equipos de la oficina. Sigue la API fijada por el cliente para el inventario de IT."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "google": [] }],
  "paths": {
    "/api/equipos": {
      "post": {
        "operationId": "equipos.crearEquipo",
        "summary": "Dar de alta un equipo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/AltaDeEquipo" } }
          }
        },
        "responses": {
          "201": {
            "description": "Equipo dado de alta, sin prestar",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Equipo" } }
            }
          },
          "400": {
            "description": "«Falta el nombre del equipo», si el nombre falta o está vacío",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "«Inicia sesión con Google.», sin un token válido",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "409": {
            "description": "«Ya hay un equipo con ese nombre»",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "google": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token de identidad de Google, con el correo verificado, emitido para el cliente OAuth de la aplicación; de una persona o de una cuenta de servicio"
      }
    },
    "schemas": {
      "AltaDeEquipo": {
        "type": "object",
        "required": ["nombre"],
        "properties": {
          "nombre": { "type": "string", "examples": ["Portátil 07"] }
        }
      },
      "Equipo": {
        "type": "object",
        "required": ["id", "nombre", "prestado"],
        "properties": {
          "id": { "type": "string" },
          "nombre": { "type": "string", "examples": ["Portátil 07"] },
          "prestado": { "type": "boolean", "const": false }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string", "description": "El mensaje exacto de la API fijada por el cliente" }
        }
      }
    }
  }
}
