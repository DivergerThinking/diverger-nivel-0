{
  "openapi": "3.1.0",
  "info": {
    "title": "Equipos",
    "version": "1.0.0",
    "description": "API fijada por el cliente para el inventario de IT (intent.md, «API fijada por el cliente»). Rutas, campos, códigos y mensajes de error son los del cliente, carácter a carácter."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "google": [] }],
  "paths": {
    "/api/equipos": {
      "post": {
        "operationId": "equipos.crearEquipo",
        "summary": "Dar de alta un equipo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/NuevoEquipo" } }
          }
        },
        "responses": {
          "201": {
            "description": "Equipo dado de alta",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Equipo" } }
            }
          },
          "400": {
            "description": "Falta el nombre del equipo",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Falta el nombre del equipo" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/SinSesion" },
          "409": {
            "description": "Ya hay un equipo con ese nombre",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Ya hay un equipo con ese nombre" }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "equipos.listarEquipos",
        "summary": "Ver los equipos",
        "responses": {
          "200": {
            "description": "Lista de equipos; los prestados llevan también persona y devolucion",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Equipo" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/SinSesion" }
        }
      }
    },
    "/api/equipos/{id}/prestamo": {
      "post": {
        "operationId": "equipos.prestarEquipo",
        "summary": "Prestar un equipo",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/NuevoPrestamo" } }
          }
        },
        "responses": {
          "201": {
            "description": "Equipo prestado: id, nombre, prestado true, persona y devolucion",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Equipo" } }
            }
          },
          "400": {
            "description": "Faltan la persona o la fecha de devolución, o la fecha de devolución no es válida",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "faltanDatos": { "value": { "error": "Faltan la persona o la fecha de devolución" } },
                  "fechaNoValida": { "value": { "error": "La fecha de devolución no es válida" } }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/SinSesion" },
          "404": { "$ref": "#/components/responses/NoExiste" },
          "409": {
            "description": "El equipo ya está prestado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "El equipo ya está prestado" }
              }
            }
          }
        }
      }
    },
    "/api/equipos/{id}/devolucion": {
      "post": {
        "operationId": "equipos.devolverEquipo",
        "summary": "Apuntar la devolución",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": {
            "description": "Equipo devuelto, con prestado false",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Equipo" } }
            }
          },
          "401": { "$ref": "#/components/responses/SinSesion" },
          "404": { "$ref": "#/components/responses/NoExiste" },
          "409": {
            "description": "El equipo no está prestado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "El equipo no está prestado" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "google": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token de identidad de Google con el correo verificado y emitido para el cliente OAuth de la aplicación (GOOGLE_CLIENT_ID); también el de la cuenta de servicio del inventario de IT"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "SinSesion": {
        "description": "Sin un token de identidad válido",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Inicia sesión con Google." }
          }
        }
      },
      "NoExiste": {
        "description": "No existe el equipo",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "No existe el equipo" }
          }
        }
      }
    },
    "schemas": {
      "NuevoEquipo": {
        "type": "object",
        "properties": { "nombre": { "type": "string" } }
      },
      "NuevoPrestamo": {
        "type": "object",
        "properties": {
          "persona": { "type": "string" },
          "devolucion": { "type": "string", "description": "Fecha AAAA-MM-DD; se devuelve con el mismo texto" }
        }
      },
      "Equipo": {
        "type": "object",
        "required": ["id", "nombre", "prestado"],
        "properties": {
          "id": { "type": "string" },
          "nombre": { "type": "string" },
          "prestado": { "type": "boolean" },
          "persona": { "type": "string", "description": "Solo cuando prestado es true" },
          "devolucion": { "type": "string", "description": "Solo cuando prestado es true; fecha AAAA-MM-DD tal como se envió" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      }
    }
  }
}
