{
  "openapi": "3.1.0",
  "info": {
    "title": "Avisos",
    "version": "1.0.0",
    "description": "Contexto avisos de la iniciativa de prueba de la escalera de reintentos."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "google": []
    }
  ],
  "paths": {
    "/api/avisos": {
      "post": {
        "operationId": "avisos.mandarAviso",
        "summary": "Manda un aviso por correo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "para": {
                    "type": "string"
                  },
                  "texto": {
                    "type": "string"
                  }
                },
                "required": [
                  "texto"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Aviso mandado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "enviado": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "enviado"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Falta el destinatario",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Falta el inicio de sesión o el token no es válido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "avisos.listarAvisos",
        "summary": "Lista los avisos mandados",
        "responses": {
          "200": {
            "description": "Avisos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "para": {
                        "type": "string"
                      },
                      "texto": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "para",
                      "texto"
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Falta el inicio de sesión o el token no es válido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "google": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token de identidad de Google (Google Identity Services)"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
